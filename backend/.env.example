# Backend runtime config. This file is only an example.
#
# Development:
#   Copy to backend/.env and fill in local values.
#
# Installed app:
#   The backend reads user config from the app storage config/.env file:
#   - macOS:   ~/Library/Application Support/Shoko/config/.env
#   - Windows: %LOCALAPPDATA%\Shoko\config\.env
#   - Linux:   ${XDG_DATA_HOME:-~/.local/share}/Shoko/config/.env

OPENAI_API_KEY=""
GEMINI_API_KEY=""
SEGMIND_API_KEY=""

# Optional asset URL cache backend. Defaults to local SQLite.
# Set to "supabase" only when SUPABASE_URL and a Supabase key are configured.
# LOKA_ASSET_CACHE_BACKEND="sqlite"
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional, disabled by default. Keeps remote audio upload available for future
# workflows while current prompting uses transcribed dialogue text.
# LOKA_ENABLE_REFERENCE_AUDIO_UPLOAD="0"

# Optional. Set LOKA_STORAGE_DIR as a real OS environment variable if you need
# to override app storage. Do not store it in this file for installed users.
# LOKA_APP_VERSION="0.1.0"
